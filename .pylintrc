[MAIN]
jobs = 1
suggestion-mode = yes
max-line-length = 120

[MASTER]
ignore-paths = ^addons_third_party/,^docker/,^env/
persistent = yes
load-plugins = pylint_odoo
valid-odoo-versions = 18.0

[BASIC]
module-rgx = (([a-z0-9_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$
const-rgx = (([A-Z_][A-Z0-9_]*)|(__.*__)|log|urlpatterns)$
class-rgx = [A-Z_][a-zA-Z0-9]+$
function-rgx = ([a-z_][a-z0-9_]{2,40}|test_[a-z0-9_]+)$
method-rgx = ([a-z_][a-z0-9_]{2,40}|setUp|set[Uu]pClass|tearDown|tear[Dd]ownClass|assert[A-Z]\w*|maxDiff|test_[a-z0-9_]+)$
attr-rgx = [a-z_][a-z0-9_]{2,30}$
argument-rgx = [a-z_][a-z0-9_]{0,30}$
variable-rgx = [a-z_][a-z0-9_]{0,30}$
class-attribute-rgx = ([A-Za-z_][A-Za-z0-9_]{2,30}|(__.*__))$
inlinevar-rgx = [A-Za-z_][A-Za-z0-9_]*$
bad-names = l
no-docstring-rgx = __.*__$|test_.+|setUp$|setUpClass$|tearDown$|tearDownClass$|Meta$
docstring-min-length = 5

[FORMAT]
max-module-lines = 400
indent-string = '    '

[SIMILARITIES]
min-similarity-lines = 7
ignore-comments = yes
ignore-docstrings = yes
ignore-imports = no

[TYPECHECK]
ignore-mixin-members = yes
unsafe-load-any-extension = yes
generated-members =
    REQUEST,
    acl_users,
    aq_parent,
    objects,
    DoesNotExist,
    can_read,
    can_write,
    get_url,
    size,
    content,
    status_code,
    create,
    build,
    fields,
    tag,
    org,
    course,
    category,
    name,
    revision,
    _meta,

[VARIABLES]
init-import = no
dummy-variables-rgx = _|dummy|unused|.*_unused
additional-builtins =

[CLASSES]
defining-attr-methods = __init__,__new__,setUp
valid-classmethod-first-arg = cls
valid-metaclass-classmethod-first-arg = mcs

[DESIGN]
; LEVEL 4: (complexity) uncomment the next line as the next level of refactoring
;max-args = 7
max-args = 20
ignored-argument-names = _.*
; LEVEL 4: (complexity) uncomment the next line as the next level of refactoring
;max-locals = 15
max-locals = 25
max-returns = 6
max-branches = 12
max-statements = 50
max-parents = 7
; LEVEL 4: (complexity) uncomment the next line as the next level of refactoring
;max-attributes = 7
max-attributes = 15
min-public-methods = 2
max-public-methods = 20
max-bool-expr = 8
recursive = yes

[MESSAGES CONTROL]
disable =
    protected-access,
    missing-function-docstring,
    import-error,
    missing-module-docstring,
    missing-class-docstring,
    too-few-public-methods,
    missing-readme,
    logging-format-interpolation,
    translation-required,
    manifest-required-author,
    manifest-deprecated-key,
    logging-fstring-interpolation,
    access-member-before-definition,
    self-cls-assignment,
    no-member,
    unspecified-encoding,
    no-wizard-in-models,
    attribute-defined-outside-init,
    translation-not-lazy,
    fixme,
    self-assigning-variable,
    method-required-super,
    unused-argument,
    consider-using-f-string,
    invalid-name, ; is very wide, can we use Flake8 to make it more specific?
    consider-merging-classes-inherited,


; TODO: remove or comment one by one as the next levels of refactoring
; LEVEL 1: readability and common considerations:
    attribute-string-redundant,

; LEVEL 2: readability and common considerations:


; LEVEL 3: error-prone and bad practice: ; use Flake8 instead
    broad-except,
    super-with-arguments,
    redefined-outer-name,
    cell-var-from-loop,
    unused-variable,
; questionable:
    c-extension-no-member,

; LEVEL 4: complexity: ; use Flake8 instead
    similarities,
    too-many-lines,
