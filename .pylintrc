[MASTER]
load-plugins=pylint_odoo
# Pinned to this branch's version so a manifest carrying another major's prefix
# is caught. Note the pinned pylint-odoo (v8.0.19) knows Odoo versions up to
# 16.0 only and silently suppresses every one of its own messages when this
# names a version above that, so none of its checks currently fire; pylint's
# core checks still do. See docs/odoo-version-recipes.md in the template
# repository.
valid-odoo-versions=17.0

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
# import-error: Odoo is not installed in the lint environment, so every `from odoo import ...` is
# unresolvable.
disable=missing-docstring,invalid-name,too-few-public-methods,import-error
