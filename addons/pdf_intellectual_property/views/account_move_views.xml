        <field name="name">account.move.form(pdf_intellectual_property)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']/group/group[@name='accounting_info_group']" position="inside">
                <field name="intellectual_property"/>
            </xpath>
        </field>
    </record>
</odoo>
