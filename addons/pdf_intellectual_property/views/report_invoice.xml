<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//th[@name='th_quantity']" position="replace">
                <th name="th_quantity" class="text-end" t-if="not o.intellectual_property"><span>Quantity</span></th>
            </xpath>

            <xpath expr="//th[@name='th_discount']" position="replace">
                <th name="th_discount"
                    t-if="display_discount"
                    t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>Disc.<t t-esc="'%' if not o.intellectual_property else ''" /></span>
                </th>
            </xpath>

            <xpath expr="//td[@name='td_quantity']" position="replace">
                <td name="td_quantity" t-if="not o.intellectual_property" class="text-end text-nowrap">
                    <span t-field="line.quantity">3.00</span>
                    <span t-field="line.product_uom_id"  groups="uom.group_uom">units</span>
                </td>
            </xpath>

            <xpath expr="//td[@name='td_discount']" position="replace">
                <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <t t-set="discount_amount" t-value="line.quantity * line.price_unit * line.discount / 100" />
                    <span class="text-nowrap">
                        <t t-esc="o.company_id.currency_id.symbol if o.intellectual_property else ''"/>
                        <t t-esc="discount_amount if o.intellectual_property else line.discount"/>
                    </span>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
