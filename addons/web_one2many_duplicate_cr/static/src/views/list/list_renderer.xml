<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//thead/tr" position="inside">
            <th></th>
        </xpath>
    </t>

    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('o_data_row')]" position="inside">
            <t t-if="showCopyButton">
                <td class="o_list_record_copy text-center"
                    t-on-keydown.synthetic="(ev) => this.onCellKeydown(ev, group, record)"
                    t-on-click.stop="() => this.onCopyRecord(record)"
                    tabindex="-1">
                    <button class="fa fa-copy"
                        name="copy"
                        title="Copy row"
                        aria-label="Copy row"
                        tabindex="-1"/>
                </td>
            </t>
        </xpath>
    </t>

</templates>
