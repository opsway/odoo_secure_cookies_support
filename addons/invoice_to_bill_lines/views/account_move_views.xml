<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_to_bill_lines" model="ir.ui.view">
        <field name="name">account.move.form.invoice.to.bill.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']/group/group[@name='accounting_info_group']" position="inside">
                <field name="invoice_date_filter"
                       invisible="move_type not in ['in_invoice', 'in_refund']"/>
                <field name="bill_line_quantity"
                       invisible="move_type not in ['in_invoice', 'in_refund']"/>
                <button name="action_generate_bill_lines_from_invoices"
                        string="Generate Lines from Invoices"
                        type="object"
                        class="btn-primary"
                        invisible="move_type not in ['in_invoice', 'in_refund'] or state != 'draft'"
                        help="Generate bill lines from customer invoices for the selected month"/>
            </xpath>
        </field>
    </record>
</odoo>
