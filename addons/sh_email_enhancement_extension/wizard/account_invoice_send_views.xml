<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="account_invoice_send_wizard_form_email_enhancement" model="ir.ui.view">
            <field name="name">account.invoice.send.form.email.enhancement</field>
            <field name="model">account.move.send.wizard</field>
            <field name="inherit_id" ref="account.account_move_send_wizard_form"/>
            <field name="arch" type="xml">
                <field name="subject" position="before">
                    <field name="email_cc_ids" widget="many2many_tags_email" placeholder="Add contacts to notify..."/>
                    <field name="email_bcc_ids" widget="many2many_tags_email" placeholder="Add contacts to notify..."/>
                </field>
            </field>
        </record>

    </data>

</odoo>
