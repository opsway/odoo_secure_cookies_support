<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_analytic_percentage" model="ir.ui.view">
        <field name="name">account.move.form.analytic.percentage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']/group/group[@name='accounting_info_group']" position="inside">
                <field name="analytic_plan_id" 
                       invisible="move_type not in ['in_invoice', 'in_refund']"/>
                <field name="analytic_plan_percentage" 
                       invisible="move_type not in ['in_invoice', 'in_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>