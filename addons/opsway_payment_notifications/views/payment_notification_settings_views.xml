<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Search View -->
        <record id="payment_notification_settings_search_view" model="ir.ui.view">
            <field name="name">payment.notification.settings.search</field>
            <field name="model">payment.notification.settings</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="notification_type"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <group string="Group By">
                        <filter name="group_by_type" string="Notification Type" context="{'group_by': 'notification_type'}"/>
                        <filter name="group_by_active" string="Active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tree View -->
        <record id="payment_notification_settings_tree_view" model="ir.ui.view">
            <field name="name">payment.notification.settings.tree</field>
            <field name="model">payment.notification.settings</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="notification_type"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="payment_notification_settings_form_view" model="ir.ui.view">
            <field name="name">payment.notification.settings.form</field>
            <field name="model">payment.notification.settings</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Setting Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="notification_type"/>
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="All Payments" invisible="notification_type != 'all_payments'">
                                <field name="all_payment_user_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="email"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Partner Specific" invisible="notification_type != 'partner_specific'">
                                <group>
                                    <field name="partner_specific_user_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="email"/>
                                        </list>
                                    </field>
                                </group>
                                <group>
                                    <field name="partner_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="email"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="payment_notification_settings_action" model="ir.actions.act_window">
            <field name="name">Payment Notification Settings</field>
            <field name="res_model">payment.notification.settings</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create payment notification settings
                </p>
                <p>
                    Configure users who will receive email notifications when payments are received.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            id="payment_notification_settings_menu"
            name="Payment Notifications"
            parent="account.menu_finance_configuration"
            action="payment_notification_settings_action"
            sequence="100"/>

    </data>
</odoo>
