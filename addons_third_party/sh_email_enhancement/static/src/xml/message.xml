<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//em[contains(@class, 'text-muted') and contains(text(), 'Subject:')]" position="before">
            <div class="text-break" style="color: #adb5bd !important;">
                <t t-if="this.emailState.cc_email">
                    <span>CC: </span><b><t t-esc="this.emailState.cc_email" /></b><br />
                </t>
                <t t-if="this.emailState.bcc_email">
                    <span>BCC: </span><b><t t-esc="this.emailState.bcc_email" /></b><br />
                </t>
            </div>
        </xpath>
    </t>
</templates>
